<Window x:Class="NotifyVox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NotifyVox.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NotifyVox 設定"
        Width="860"
        Height="680"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダステータスバー -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="今すぐミュート (_M)"
                              IsChecked="{Binding IsManuallyMuted}"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <Button Content="テスト発話 (_T)" Command="{Binding TestSpeechCommand}" />
                    <Button Content="停止 (_S)" Command="{Binding StopSpeechCommand}" Margin="0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="NotifyVox — Windows 通知リアルタイム読み上げ"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="15" />
                    <TextBlock Text="{Binding EngineStatusText}"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4タブ構成 (SPEC §4.6) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#CBD5E1">

            <!-- ==========================================
                 タブ 1: アプリ一覧 (SPEC §4.6-1)
                 ========================================== -->
            <TabItem Header="1. アプリ一覧 (_1)">
                <DockPanel Margin="10">
                    <!-- 通知アクセス未許可時の誘導バナー (SPEC F1) -->
                    <Border DockPanel.Dock="Top"
                            Visibility="{Binding IsNotificationAccessWarningVisible, Converter={StaticResource BoolToVis}}"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="通知アクセスの確認が必要です"
                                       FontWeight="Bold"
                                       Foreground="#991B1B" />
                            <TextBlock Text="{Binding NotificationAccessMessage}"
                                       Foreground="#7F1D1D"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Windows の通知アクセス設定を開く (_W)"
                                        Command="{Binding OpenWindowsNotificationSettingsCommand}" />
                                <Button Content="状態を再チェック (_R)"
                                        Command="{Binding RecheckNotificationAccessCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 上部説明＆一括操作 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="すべて ON" Command="{Binding EnableAllAppsCommand}" />
                            <Button Content="すべて OFF" Command="{Binding DisableAllAppsCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="#475569" TextWrapping="Wrap"
                                   Text="通知を受け取ったアプリが自動的に候補表示されます。読み上げたいアプリを ON にしてください（変更は即時保存されます）。" />
                    </DockPanel>

                    <!-- 手動追加フッタ -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="AppId:" Target="{Binding ElementName=ManualAppIdBox}" VerticalAlignment="Center" />
                            <TextBox x:Name="ManualAppIdBox" Grid.Column="1"
                                     Text="{Binding NewAppId, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="4,0,10,0"
                                     ToolTip="AUMID またはアプリの識別子" />
                            <Label Grid.Column="2" Content="表示名:" Target="{Binding ElementName=ManualAppNameBox}" VerticalAlignment="Center" />
                            <TextBox x:Name="ManualAppNameBox" Grid.Column="3"
                                     Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="4,0,10,0" />
                            <Button Grid.Column="4" Content="手動追加 (_A)" Command="{Binding AddManualAppCommand}" Margin="0" />
                        </Grid>
                    </Border>

                    <!-- アプリカードリスト -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AppRules}"
                                      KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppRuleItemViewModel}">
                                    <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          ToolTip="このアプリの通知を読み上げる" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding AppId}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding DataContext.PerAppSpeakerOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding StyleId}"
                                                          SelectedValuePath="StyleId"
                                                          DisplayMemberPath="DisplayName"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          ToolTip="アプリ別話者スタイル" />

                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding DataContext.PriorityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding Priority}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="DisplayName"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          ToolTip="読み上げ優先度" />

                                                <Button Grid.Column="4"
                                                        Content="削除"
                                                        Command="{Binding RemoveCommand}"
                                                        Margin="0" />
                                            </Grid>

                                            <!-- アプリ別の詳細設定（テンプレート上書き・個別ミュートワード） -->
                                            <Expander Header="詳細設定（個別テンプレート・個別ミュートワード）"
                                                      Margin="24,6,0,0"
                                                      FontSize="12"
                                                      Foreground="#475569">
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="個別テンプレート (空欄で既定):" VerticalAlignment="Center" Margin="0,0,8,6" />
                                                    <TextBox Grid.Row="0" Grid.Column="1"
                                                             Text="{Binding TemplateOverride, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,0,6" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="個別ミュート語 (カンマ区切り):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Grid.Row="1" Grid.Column="1"
                                                             Text="{Binding MuteKeywordsCsv, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ==========================================
                 タブ 2: 読み上げ (SPEC §4.6-2)
                 ========================================== -->
            <TabItem Header="2. 読み上げ (_2)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="話者・音声パラメータ" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="既定の話者スタイル (_V):" Target="{Binding ElementName=DefaultSpeakerCombo}" />
                                    <ComboBox x:Name="DefaultSpeakerCombo"
                                              Grid.Column="1"
                                              ItemsSource="{Binding DefaultSpeakerOptions}"
                                              SelectedValue="{Binding DefaultStyleId}"
                                              SelectedValuePath="StyleId"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="話者再取得" Command="{Binding RefreshVoicevoxCommand}" Margin="0" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="話速 (Speed):" Target="{Binding ElementName=SpeedSlider}" />
                                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.50" Maximum="2.00" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding SpeedScale}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeedScale, StringFormat={}{0:F2}x}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="音高 (Pitch):" Target="{Binding ElementName=PitchSlider}" />
                                    <Slider x:Name="PitchSlider" Grid.Column="1" Minimum="-0.15" Maximum="0.15" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            Value="{Binding PitchScale}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PitchScale, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="抑揚 (Intonation):" Target="{Binding ElementName=IntonationSlider}" />
                                    <Slider x:Name="IntonationSlider" Grid.Column="1" Minimum="0.00" Maximum="2.00" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding IntonationScale}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding IntonationScale, StringFormat={}{0:F2}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="再生音量 (Volume):" Target="{Binding ElementName=VolumeSlider}" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding VolumePercent}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="出力デバイス (_D):" Target="{Binding ElementName=DeviceCombo}" />
                                    <ComboBox x:Name="DeviceCombo"
                                              Grid.Column="1"
                                              ItemsSource="{Binding OutputDevices}"
                                              SelectedValue="{Binding SelectedOutputDeviceId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="更新" Command="{Binding RefreshOutputDevicesCommand}" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="読み上げテンプレートとテキスト整形" />

                                <Label Content="既定テンプレート ({app}, {title}, {body}, {time}):" Target="{Binding ElementName=TemplateBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="TemplateBox"
                                         Text="{Binding ReadingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Margin="0,0,0,10" />

                                <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Label Content="1通知あたりの最大文字数:" Target="{Binding ElementName=MaxCharsBox}" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxCharsBox"
                                             Width="72"
                                             Text="{Binding MaxCharsPerNotification, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0,16,0" />
                                    <CheckBox Content="超過時に「以下省略」を付ける"
                                              IsChecked="{Binding AppendOmittedSuffix}"
                                              VerticalAlignment="Center" />
                                </WrapPanel>

                                <CheckBox Content="本文中の URL を「URL」と読み替える（連続絵文字は自動除去）"
                                          IsChecked="{Binding SpeakUrlAsWord}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==========================================
                 タブ 3: ミュート (SPEC §4.6-3)
                 ========================================== -->
            <TabItem Header="3. ミュート (_3)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="手動ミュートとグローバルホットキー" />

                                <CheckBox Content="手動ミュートを有効にする（有効時はすべての通知読み上げを一時停止）"
                                          IsChecked="{Binding IsManuallyMuted}"
                                          Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="ミュート切替ホットキー (_H):" Target="{Binding ElementName=HotkeyBox}" />
                                    <TextBox x:Name="HotkeyBox"
                                             Grid.Column="1"
                                             Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding HotkeyStatusText}"
                                               Foreground="#475569"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="おやすみモード・フルスクリーン制御" />

                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <CheckBox Content="おやすみ時間帯は自動でミュートする"
                                              IsChecked="{Binding QuietHoursEnabled}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0" />
                                    <Label Content="開始 (HH:mm):" Target="{Binding ElementName=QuietStartBox}" />
                                    <TextBox x:Name="QuietStartBox" Width="68"
                                             Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="4,0,12,0" />
                                    <Label Content="終了 (HH:mm):" Target="{Binding ElementName=QuietEndBox}" />
                                    <TextBox x:Name="QuietEndBox" Width="68"
                                             Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="4,0,0,0" />
                                </WrapPanel>

                                <CheckBox Content="フルスクリーンアプリ（ゲーム・全画面動画）実行中はミュートする（既定: OFF）"
                                          IsChecked="{Binding MuteWhenFullscreen}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="全体ミュートキーワード（1行に1キーワード）" />
                                <TextBlock Text="タイトルまたは本文に以下の語句を含む通知は読み上げません（大文字小文字を区別しません）。"
                                           Foreground="#64748B" FontSize="12" Margin="0,0,0,6" />
                                <TextBox Text="{Binding GlobalKeywordsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         Height="140"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==========================================
                 タブ 4: 全般・履歴 (SPEC §4.6-4, §4.7 F27)
                 ========================================== -->
            <TabItem Header="4. 全般・履歴 (_4)">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="スタートアップと VOICEVOX エンジン連携" />

                                <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                                    <CheckBox Content="Windows サインイン時に NotifyVox を自動起動する"
                                              IsChecked="{Binding LaunchOnWindowsStartup}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding StartupStatusMessage}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <CheckBox Content="起動時にアクションセンターの未読通知を読む（最大件数:"
                                              IsChecked="{Binding ReadUnreadOnStartup}"
                                              VerticalAlignment="Center" />
                                    <TextBox Width="48"
                                             Text="{Binding MaxUnreadOnStartup, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Margin="6,0,6,0" />
                                    <TextBlock Text="件）" VerticalAlignment="Center" />
                                </WrapPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="VOICEVOX エンドポイント:" Target="{Binding ElementName=EndpointBox}" />
                                    <TextBox x:Name="EndpointBox" Grid.Column="1"
                                             Text="{Binding VoicevoxEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="公式サイトを開く" Command="{Binding OpenVoicevoxWebsiteCommand}" Margin="0" />
                                </Grid>

                                <!-- SPEC §8: localhost 以外のエンドポイント警告 -->
                                <TextBlock Visibility="{Binding IsNonLoopbackEndpointWarningVisible, Converter={StaticResource BoolToVis}}"
                                           Text="⚠️ 警告: localhost 以外のアドレスが指定されています。通知内容がネットワーク経由で外部へ送信される恐れがあります。"
                                           Foreground="#DC2626"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="エンジン実行ファイルパス:" Target="{Binding ElementName=EnginePathBox}" />
                                    <TextBox x:Name="EnginePathBox" Grid.Column="1"
                                             Text="{Binding EngineExePath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="参照..." Command="{Binding BrowseEngineExeCommand}" Margin="0" />
                                </Grid>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="ログフォルダを開く" Command="{Binding OpenLogsDirectoryCommand}" />
                                        <Button Content="設定フォルダを開く" Command="{Binding OpenSettingsDirectoryCommand}" Margin="0" />
                                    </StackPanel>
                                    <CheckBox Content="起動時に VOICEVOX 未接続なら上記パスから自動起動を試みる"
                                              IsChecked="{Binding AutoStartEngine}"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 履歴ヘッダ -->
                        <DockPanel Margin="0,0,0,6">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Label Content="保持日数:" Target="{Binding ElementName=RetentionBox}" />
                                <TextBox x:Name="RetentionBox" Width="48"
                                         Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Margin="4,0,6,0" />
                                <TextBlock Text="日" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="履歴をクリア" Command="{Binding ClearHistoryCommand}" Margin="0" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="直近の通知・読み上げ履歴 (最大200件表示)" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                    </StackPanel>

                    <!-- 履歴テーブル -->
                    <DataGrid ItemsSource="{Binding RecentHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日時" Binding="{Binding TimeDisplay}" Width="115" />
                            <DataGridTextColumn Header="アプリ" Binding="{Binding AppName}" Width="130" />
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="150" />
                            <DataGridTextColumn Header="本文" Binding="{Binding Body}" Width="*" />
                            <DataGridTextColumn Header="状態" Binding="{Binding StatusDisplay}" Width="165" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>

        <TextBlock Grid.Row="2"
