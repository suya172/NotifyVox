<Project Sdk="Microsoft.NET.Sdk">

  <!--
    プラットフォーム非依存のドメインロジック。
    TextFormatter / FilterPolicy / SpeechQueue / SettingsStore / VoicevoxClient (HTTP) など。
    WinRT・NAudio・WPF に依存させないことで単体テストを容易にする (SPEC §11)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotifyVox.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NotifyVox.Core.Tests" />
  </ItemGroup>

</Project>
